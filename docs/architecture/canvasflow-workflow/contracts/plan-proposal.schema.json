{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/contracts/plan-proposal.schema.json",
  "title": "PlanProposal",
  "description": "一份完整的数据处理链路设计。每一轮都是完整的一份，不是上一份的改动。",
  "type": "object",
  "additionalProperties": false,
  "required": ["readiness", "goal", "understanding", "steps", "openQuestions"],
  "properties": {
    "readiness": {
      "description": "这条链路当前的可用程度。ready：该问的都问清了，可以交给执行；partial：形状对了，但还有参数要用户自己填。ready 不代表生成后的工作流一定能跑通，跑不跑得通由执行裁决。",
      "type": "string",
      "enum": ["ready", "partial"]
    },
    "goal": {
      "description": "端到端意图，一句话。",
      "type": "string",
      "minLength": 1
    },
    "understanding": {
      "description": "对用户原话的逐段回读。按他说话的自然停顿切分，不按 steps 切分，两边条数可以不同。",
      "type": "array",
      "items": { "$ref": "#/$defs/reading" }
    },
    "steps": {
      "description": "这条链路的环节。数据形态转变一次，就是一步。",
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    },
    "openQuestions": {
      "description": "用户还没说明、而这条链路需要的信息。全部列出，不要筛选。",
      "type": "array",
      "items": { "$ref": "#/$defs/openQuestion" }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "quote", "reading"],
      "properties": {
        "ref": { "$ref": "#/$defs/ref" },
        "quote": {
          "description": "用户原话里的片段，原样摘出，不要改写。",
          "type": "string",
          "minLength": 1
        },
        "reading": {
          "description": "这一段被读成了什么。",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "title", "intent", "input", "output", "dependsOn"],
      "properties": {
        "ref": { "$ref": "#/$defs/ref" },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "description": "这一环要达到什么结果。不写用什么工具、怎么实现。",
          "type": "string",
          "minLength": 1
        },
        "input": {
          "description": "数据进这一环时处于什么形态。链路第一环填的是用户手上现在有的东西，整条链从它长出来。由时间或事件信号触发、不接收上游数据的环节，在这里说明。",
          "type": "string",
          "minLength": 1
        },
        "output": {
          "description": "数据离开这一环时变成什么形态。下一环从这个形态接着往下推。",
          "type": "string",
          "minLength": 1
        },
        "dependsOn": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" },
          "uniqueItems": true
        }
      }
    },
    "openQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "question", "reason", "affects"],
      "properties": {
        "ref": { "$ref": "#/$defs/ref" },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "description": "缺了这条信息，这条链路的哪个部分说不清楚。",
          "type": "string",
          "minLength": 1
        },
        "affects": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref" },
          "uniqueItems": true
        },
        "options": {
          "description": "备选项。你知道答案有哪几种可能时填上（比如扫描件还是带文字层），用户可以选也可以自己写；答案只存在于用户那边、你列不出来的（比如写哪张表），不填。",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
